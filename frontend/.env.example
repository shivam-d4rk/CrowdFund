# Paste your deployed contract from Remix here.
VITE_CROWDFUND_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Sepolia chain id
VITE_CHAIN_ID=11155111

# Optional display-only Alchemy RPC URL
VITE_ALCHEMY_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR-KEY

# Frontend Groq API key (exposed to browser bundle)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional Groq model override used by frontend
VITE_GROQ_MODEL=llama-3.1-8b-instant
